[Unit]
Description=DeepSeek Harness for dafeiyu-girlfriend-qq
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zxy/dev_ws/ros/dafeiyu-girlfriend-qq
Environment=HOME=/home/zxy/.local/share/dsh-envs/dafeiyu-girlfriend-qq-v1/data
Environment=PATH=/home/zxy/.local/share/dsh-envs/dafeiyu-girlfriend-qq-v1/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/zxy/.local/share/dsh-envs/dafeiyu-girlfriend-qq-v1/runtime/node_modules/.bin/dsh web --host 127.0.0.1 --port 3080 --no-open
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
