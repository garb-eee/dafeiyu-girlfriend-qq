# 大肥鱼女朋友 · 环境变量模板
# 复制为 .env 后**在 5060 主机本地**填写；.env 已被 .gitignore 屏蔽，永不入库、
# 永不粘贴到聊天/Issue/日志。以下全部为空占位，没有任何真实值。

# --- OneBot 11（引擎 → NapCat 的正向 WS） ---
ONEBOT_WS_URL=
ONEBOT_ACCESS_TOKEN=

# --- 模型（OpenAI 兼容端点） ---
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# --- 运行模式：paused | receive_only | single | live ---
DFYQQ_RUN_MODE=paused

# --- 主动联系：off | on（on 之前必须先确认四个参数） ---
DFYQQ_PROACTIVE=off

# --- 主动联系参数（开启后才生效） ---
DFYQQ_PROACTIVE_DAILY_MAX=2
DFYQQ_PROACTIVE_MIN_INTERVAL_MIN=180
DFYQQ_PROACTIVE_QUIET_START=23:00
DFYQQ_PROACTIVE_QUIET_END=08:00
DFYQQ_PROACTIVE_MAX_UNANSWERED=2
