# 大肥鱼 MCP 凭据模板。复制为 .env.mcp 后只在本机填写。
# .env.mcp 已被 .gitignore 排除，不要提交、截图或粘贴到聊天中。

# 韩国 Naver 搜索：Shopping / Cafe / Blog / News / Local
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 中国商品搜索：至少完整填写一个平台。缺凭据时生产配置保持禁用，
# 不会把上游的 mock.local 假商品暴露给 QQ 用户。
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
TAOBAO_PID=
JD_APP_KEY=
JD_APP_SECRET=
JD_SITE_ID=
JD_POSITION_ID=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# 美国及东南亚商品搜索。由 BuyWhere 单独签发。
BUYWHERE_API_KEY=

# 默认开启无凭据的韩国公共资料远程 MCP。设为 off 可关闭。
DFYQQ_MCP_PUBLIC_DATA=on

# 仅供本机开发验收。生产环境不要开启，否则会返回 mock.local 假商品。
DFYQQ_MCP_ALLOW_MOCK=0
SHOPPING_MCP_MOCK=0
